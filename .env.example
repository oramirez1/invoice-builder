# PostgreSQL connection (Supabase: use the pooled "Transaction" URL here, port 6543, with ?pgbouncer=true)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/invoice_builder"
# Direct connection used by Prisma for schema changes (Supabase: the "Session"/direct URL, port 5432)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/invoice_builder"
# Long random string used to sign login sessions. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me"
# The account that signs up with this email becomes the admin and is approved automatically
ADMIN_EMAIL="you@yourcompany.com"
